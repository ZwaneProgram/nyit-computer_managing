# Copy this file to ".env" and fill in real values. NEVER commit ".env".

# Postgres connection string.
# Local dev (after installing PostgreSQL natively and creating a "nyit" database):
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/nyit

# Secret used to sign login session JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Secret for signed cookies (can be a different long random string).
COOKIE_SECRET=change-me-too

# Port the API listens on.
PORT=3000
