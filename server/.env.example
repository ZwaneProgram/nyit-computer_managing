# Copy this file to ".env" and fill in real values. NEVER commit ".env".

# Postgres connection string.
# Local dev (after installing PostgreSQL natively and creating a "nyit" database):
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/nyit

# Secret used to sign login session JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Secret for signed cookies (can be a different long random string).
COOKIE_SECRET=change-me-too

# Port the API (and, in production, the whole app) listens on.
PORT=3000

# Set to "true" ONLY when the site is served over HTTPS. On plain http (e.g. an
# IP:port test deploy) leave it false/unset or the login cookie won't be sent.
COOKIE_SECURE=false

# Optional: override where the server looks for the built frontend (dist/).
# Defaults to ../dist relative to the server. Usually leave this unset.
# FRONTEND_DIST=/var/www/nyit-app/dist

# DEV ONLY: if local dev shares the VPS database, uploaded-image rows can reference
# files that only exist on the VPS. When a /uploads/* file isn't found locally, the
# server redirects to this host so the image still shows. NEVER set this on the VPS
# (it would redirect to itself). Example for local dev:
# UPLOADS_FALLBACK_URL=http://194.233.88.142:3000
